<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="PlantBase">
		<defName>ZWB_JewelOfTheHollow</defName>
		<label>jewel-of-the-hollow</label>
		<description>PLACEHOLDER</description>
		<selectable>true</selectable>
		<altitudeLayer>Building</altitudeLayer>
		<statBases>
			<MaxHitPoints>90</MaxHitPoints>
			<Flammability>0.5</Flammability>
			<Nutrition>0.50</Nutrition>
			<Beauty>28</Beauty>
			<BeautyOutdoors>32</BeautyOutdoors>
		</statBases>
		<pathCost>18</pathCost>
		<graphicData>
			<texPath>ZWB_Textures/Plants/JewelOfTheHollow</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<ingestible/>
		<plant>
			<fertilityMin>1.5</fertilityMin>
			<fertilitySensitivity>1.0</fertilitySensitivity>
			<purpose>Beauty</purpose>
			<growDays>7.5</growDays>
			<harvestWork>120</harvestWork>
			<maxMeshCount>4</maxMeshCount>
			<visualSizeRange>1.2~2.8</visualSizeRange>
			<topWindExposure>0.4</topWindExposure>
			<lifespanDaysPerGrowDays>3</lifespanDaysPerGrowDays>
			<!-- <wildClusterRadius>4</wildClusterRadius> -->
			<!-- <wildClusterWeight>450</wildClusterWeight> -->
			<wildOrder>1</wildOrder>
		</plant>
	</ThingDef>
	
	
	<ThingDef ParentName="PlantBase">
		<defName>ZWB_Skyfell</defName>
		<label>skyfell</label>
		<description>PLACEHOLDER</description>
		<statBases>
			<Beauty>4</Beauty>
			<BeautyOutdoors>4</BeautyOutdoors>
			<Nutrition>1.25</Nutrition>
		</statBases>
		<pathCost>18</pathCost>
		<selectable>true</selectable>
		<altitudeLayer>Building</altitudeLayer>
		<graphicData>
			<texPath>ZWB_Textures/Plants/Skyfell</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<shadowData>
				<volume>(0.1, 0.35, 0.1)</volume>
				<offset>(0,0,-0.42)</offset>
			</shadowData>
		</graphicData>
		<!-- <hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth> -->
		<ingestible/>
		<plant>
			<fertilitySensitivity>0.8</fertilitySensitivity>
			<growDays>33</growDays>
			<fertilityMin>0.25</fertilityMin>
			<choppedThingDef />
			<smashedThingDef />
			<visualSizeRange>1.5~4.0</visualSizeRange>
			<topWindExposure>0.4</topWindExposure>
			<wildClusterRadius>4</wildClusterRadius>
			<wildClusterWeight>200</wildClusterWeight>
		</plant>
	</ThingDef>

		
	
	<ThingDef ParentName="PlantBase">
		<defName>ZWB_TrickyWikket</defName>
		<label>tricky wikket</label>
		<description>A large orange flower, rustling in the breeze.</description>
		<statBases>
			<Beauty>4</Beauty>
			<BeautyOutdoors>4</BeautyOutdoors>
			<Nutrition>1.25</Nutrition>
		</statBases>
		<pathCost>18</pathCost>
		<selectable>true</selectable>
		<altitudeLayer>Building</altitudeLayer>
		<graphicData>
			<texPath>ZWB_Textures/Plants/TrickyWikket</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<shadowData>
				<volume>(0.1, 0.35, 0.1)</volume>
				<offset>(0,0,-0.42)</offset>
			</shadowData>
		</graphicData>
		<!-- <hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth> -->
		<ingestible/>
		<plant>
			<fertilitySensitivity>0.8</fertilitySensitivity>
			<growDays>8</growDays>
			<fertilityMin>0.5</fertilityMin>
			<choppedThingDef />
			<smashedThingDef />
			<harvestWork>500</harvestWork>
			<visualSizeRange>1.0~2.0</visualSizeRange>
			<topWindExposure>0.4</topWindExposure>
			<wildClusterRadius>10</wildClusterRadius>
			<wildClusterWeight>280</wildClusterWeight>
		</plant>
		<modExtensions>
			<li Class="ZWBCore.ModExtension_Plant">
				<extraHarvests>
					<li>
						<harvestedThingDef>ZWB_EggWikket</harvestedThingDef>
						<harvestYield>1</harvestYield>
						<harvestChance>0.015</harvestChance>
						<harvestMinGrowth>0.9</harvestMinGrowth>
					</li>
					<li>
						<harvestedThingDef>ZWB_EggWikket</harvestedThingDef>
						<harvestYield>20</harvestYield>
						<harvestChance>0.001</harvestChance>
						<harvestMinGrowth>0.95</harvestMinGrowth>
					</li>
				</extraHarvests>
			</li>
		</modExtensions>
	</ThingDef>

</Defs>
