<?xml version="1.0" encoding="utf-8"?>
<Defs>


  <ThingDef ParentName="BigBirdThingBase">
    <defName>ZWB_Magpeck</defName>
    <label>magpeck</label>
    <description>PLACEHOLDER</description>
    <statBases>
      <MoveSpeed>4.1</MoveSpeed>
      <MarketValue>180</MarketValue>
      <ComfyTemperatureMin>-8</ComfyTemperatureMin>
      <Wildness>0.9</Wildness>
    </statBases>
    <race>
      <herdAnimal>false</herdAnimal>
      <baseBodySize>0.6</baseBodySize>
      <baseHealthScale>0.8</baseHealthScale>
      <baseHungerRate>0.15</baseHungerRate>
      <foodType>CarnivoreAnimal</foodType>
      <trainability>Advanced</trainability>
      <lifeExpectancy>7.5</lifeExpectancy>
      <soundEating>Bird_Eat</soundEating>
      <lifeStageAges>
        <li>
          <def>AnimalBabyTiny</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Chick_Call</soundWounded>
          <soundDeath>Pawn_Chick_Call</soundDeath>
          <soundCall>Pawn_Chick_Call</soundCall>
          <soundAngry>Pawn_Chick_Call</soundAngry>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.12</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.2</minAge>
        </li>
      </lifeStageAges>
      <!-- <headPosPerRotation> -->
        <!-- <li>(0.0, 0, 0.22)</li> -->
        <!-- <li>(0.3, 0, 0.21)</li> -->
        <!-- <li>(0.0, 0, 0.24)</li> -->
        <!-- <li>(-0.3, 0, 0.21)</li> -->
      <!-- </headPosPerRotation> -->
    </race>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggUnfertilizedDef>ZWB_EggMagpeckUnfertilized</eggUnfertilizedDef>
        <eggFertilizedDef>ZWB_EggMagpeckFertilized</eggFertilizedDef>
        <eggFertilizationCountMax>1</eggFertilizationCountMax>
        <eggLayIntervalDays>3.5</eggLayIntervalDays>
        <eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
        <eggCountRange>1~1</eggCountRange>
      </li>
    </comps>
    <tools>
      <li>
        <label>claws</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>7</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>18</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>beak</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <tradeTags>
      <li>AnimalUncommon</li>
      <li>AnimalFighter</li>
    </tradeTags>
  </ThingDef>

