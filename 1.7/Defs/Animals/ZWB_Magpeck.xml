  <ThingDef ParentName="EggFertBase">
    <defName>ZWB_EggMagpeckFertilized</defName>
    <label>magpeck egg (fert.)</label>
    <description>A fertilized magpeck egg. If all goes well, it should hatch into a baby magpeck. It can be eaten raw, but it's much better cooked.</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <color>(39,54,47)</color>
      <drawSize>1.1</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>11.0</MarketValue>
      <Nutrition>0.5</Nutrition>
    </statBases>
    <comps>
      <li Class="CompProperties_Hatcher">
        <hatcherDaystoHatch>5</hatcherDaystoHatch>
        <hatcherPawn>ZWB_Magpeck</hatcherPawn>
      </li>
    </comps>
  </ThingDef>

