<?xml version="1.0" encoding="utf-8"?>
<Defs>


	<ZWB_TangledHollows.FairyRingIncidentDef>
		<defName>ZWB_Incident_FairyRing</defName>
		<label>fairy ring</label>
		<category>Misc</category>
		<targetTags>
			<li>Map_PlayerHome</li>
		</targetTags>
		<minRefireDays>35</minRefireDays>
		<workerClass>ZWB_TangledHollows.IncidentWorker_FairyRing</workerClass>

		<bigPlant>ZWB_Elfcap</bigPlant>
		<smallPlant>ZWB_DeadmansFinger</smallPlant>

		<bigPlantCurve>
			<points>
				<li>(5, 0)</li>
				<li>(7, 0.6)</li>
				<li>(9, 0)</li>
			</points>
		</bigPlantCurve>
		<smallPlantCurve>
			<points>
				<li>(3, 0)</li>
				<li>(7, 0.9)</li>
				<li>(10, 0)</li>
			</points>
		</smallPlantCurve>
		<noPlantCurve>
			<points>
				<li>(0, 0.5)</li>
				<li>(6, 1)</li>
				<li>(8, 0.9)</li>
				<li>(11.5, 0)</li>
			</points>
		</noPlantCurve>

		<baseChance>1.0</baseChance>
		<letterLabel>Fairy ring</letterLabel>
		<letterText>A ring of wild mushrooms has appeared. These mushrooms are edible, and will yeild a lot of edible mushroom once mature.\n\nYou've heard that people who interfere with fairy rings come to regret it, but those stories are only rumors.</letterText>
		<letterDef>PositiveEvent</letterDef>
		<allowedBiomes>
			<li>ZWB_TangledHollows</li>
		</allowedBiomes>
	</ZWB_TangledHollows.FairyRingIncidentDef>


	<ThingDef ParentName="EtherealThingBase">
		<defName>ZWB_FairyRingController</defName>
		<selectable>false</selectable>
		<tickerType>Rare</tickerType>
		<thingClass>ZWB_TangledHollows.FairyRingController</thingClass>
		<comps>
			<li Class="ZWB_TangledHollows.CompProperties_FairyRing">
				<daysToDespawn>7.0</daysToDespawn>
				<triggerChance>0.5</triggerChance>
				<effectRadius>7.0</effectRadius>
				<hediffEffects>
					<li>
						<hediffDef>Hypothermia</hediffDef>
						<severity>0.2</severity>
						<maxSeverity>0.7</maxSeverity>
						<commonality>1.0</commonality>
						<messageText>{0} feels a chill upon passing through the fairy ring.</messageText>
					</li>
					<li>
						<hediffDef>BloodLoss</hediffDef>
						<severity>0.2</severity>
						<maxSeverity>0.55</maxSeverity>
						<commonality>0.2</commonality>
						<messageText>{0} feels lightheaded after passing through the fairy ring.</messageText>
					</li>
					<li>
						<hediffDef>AlcoholHigh</hediffDef>
						<severity>0.3</severity>
						<maxSeverity>0.8</maxSeverity>
						<commonality>0.45</commonality>
						<messageText>After passing through the fairy ring, {0} feels a bit wobbly.</messageText>
					</li>
				</hediffEffects>
			</li>
		</comps>
	</ThingDef>



  <HediffDef>
    <defName>ZWB_Hediff_FRVictim</defName>
    <label>fairy ring victim</label>
	<hediffClass>HediffWithComps</hediffClass>
    <description>This person has recently been the victim of a fairy ring.</description>
    <isBad>false</isBad>
    <comps>
		<li Class="HediffCompProperties_Disappears">
			<disappearsAfterTicks>2000~30000</disappearsAfterTicks>
			<showRemainingTime>false</showRemainingTime>
		</li>
    </comps>
		<stages>
			<li>
				<label>victimized</label>
				<!-- <becomeVisible>false</becomeVisible> -->
			</li>
		</stages>
  </HediffDef>

</Defs>
